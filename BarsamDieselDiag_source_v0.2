from pathlib import Path
import zipfile, shutil

base = Path("/mnt/data/BarsamDieselDiag")
kt = base / "app/src/main/java/ir/barsam/diag/MainActivity.kt"
s = kt.read_text(encoding="utf-8")
start = s.index("    private fun decodeDtc(raw: String): List<String> {")
end = s.index("\n    private fun confirmClearCodes()", start)
replacement = '''    private fun decodeDtc(raw: String): List<String> {
        val hex = raw.replace(Regex("[^0-9A-Fa-f]"), "").uppercase()
        val start = hex.indexOf("43")
        if (start < 0 || hex.length < start + 6) return emptyList()
        val payload = hex.substring(start + 2)
        val bytes = payload.chunked(2).filter { it.length == 2 }
        val result = mutableListOf<String>()
        var i = 0
        while (i + 1 < bytes.size) {
            val first = bytes[i].toIntOrNull(16) ?: break
            val second = bytes[i + 1].toIntOrNull(16) ?: break
            if (first == 0 && second == 0) { i += 2; continue }
            val system = listOf("P", "C", "B", "U")[(first shr 6) and 0x03]
            val digit1 = (first shr 4) and 0x03
            val digit2 = first and 0x0F
            val digit3 = (second shr 4) and 0x0F
            val digit4 = second and 0x0F
            result.add("$system$digit1${digit2.toString(16).uppercase()}${digit3.toString(16).uppercase()}${digit4.toString(16).uppercase()}")
            i += 2
        }
        return result.distinct()
    }
'''
kt.write_text(s[:start] + replacement + s[end:], encoding="utf-8")

zip_path = Path("/mnt/data/BarsamDieselDiag_source_v0.2.zip")
with zipfile.ZipFile(zip_path, "w", zipfile.ZIP_DEFLATED) as z:
    for p in base.rglob("*"):
        if p.is_file():
            z.write(p, p.relative_to(base.parent))
print(f"Updated package: {zip_path} ({zip_path.stat().st_size} bytes)")
